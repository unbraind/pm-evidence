tests[3]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  npm run typecheck && npm run lint,project,codex-sol,"2026-11-15T16:03:15.241Z",local_mutation,ci/quick-pr-tier-deep-local-tier
  PM_TEST_DEPTH=quick node --test --test-concurrency=2 test/fragment-sdk.test.ts test/criteria-model.test.ts test/coalesced-model.test.ts test/bundles.test.ts test/bundle-model.test.ts test/record-law.test.ts test/citation-roundtrip.test.ts test/release-ci.test.ts,project,codex-sol,"2026-11-15T16:06:49.102Z",local_mutation,ci/quick-pr-tier-deep-local-tier
  PM_TEST_DEPTH=quick npm run coverage,project,codex-sol,"2026-11-15T16:23:08.349Z",local_mutation,ci/quick-pr-tier-deep-local-tier
